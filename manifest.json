{
  "manifest_version": 3,
  "name": "Sentinela de Privacidade",
  "version": "0.3.0",
  "description": "Analisa indicadores de rastreamento e privacidade da página atual.",
  "permissions": [
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "action": {
    "default_title": "Sentinela de Privacidade",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sentinela-privacidade@insper.edu.br",
      "strict_min_version": "109.0"
    }
  }
}
