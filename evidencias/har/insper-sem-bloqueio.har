            "text": "{\"fragmentPath\":null,\"language\":\"pt\",\"title\":\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\",\"templateName\":\"spa-page-template\",\"lastModifiedDate\":1790690237102,\"designPath\":\"/libs/settings/wcm/designs/default\",\"brandSlug\":\"\",\"componentsResourceTypes\":[\"insper-portal/components/cookieConsent\",\"insper-portal/components/footer\",\"insper-portal/components/eventCarousel\",\"insper-portal/components/genericbanneritem\",\"nt:folder\",\"insper-portal/components/courseSearchBar\",\"insper-portal/components/structure/container\",\"insper-portal/components/spacer\",\"insper-portal/components/header\",\"insper-portal/components/structure/page\",\"insper-portal/components/genericbanner\",\"nt:unstructured\",\"insper-portal/components/fragments/experiencefragment\",\"insper-portal/components/structure/xfpage\",\"insper-portal/components/containergrid/wrapper\",\"nt:file\",\"insper-portal/components/featuredCard\",\"insper-portal/components/footerQrCode\",\"insper-portal/components/shortcutCards\",\"insper-portal/components/featuredCardContainer/container\",\"insper-portal/components/containergrid/container\",\"insper-portal/components/featuredBanner\",\"wcm/foundation/components/responsivegrid\",\"insper-portal/components/text-v2\",\"nt:resource\",\"insper-portal/components/footerLinks\",\"insper-portal/components/featuredCardContainer/wrapper\",\"insper-portal/components/newsList\"],\"htmlPageItems\":[],\"cssClassNames\":\"page basicpage\",\"genericContentFragmentData\":null,\"jsontoLLM\":\"[{\\\"subtitle\\\":\\\"Insper - Home Page\\\",\\\"jcr:title\\\":\\\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\\\",\\\"jcr:description\\\":\\\"Cursos de graduação, pós-graduação e curta duração com qualidade reconhecida internacionalmente\\\",\\\"pageTitle\\\":\\\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\\\",\\\"navTitle\\\":\\\"Insper - Home Page\\\"},{\\\"richText\\\":\\\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\\",\\\"madeBy\\\":\\\"Por\\\",\\\"tag\\\":\\\"tipos-de-conteudo:acontece-no-insper/parcerias\\\",\\\"buttonUrl\\\":\\\"https://www.insper.edu.br/pt/conteudos/acontece-no-insper/insper-celebra-25-anos-de-parceria-com-a-university-of-chicago-e-recebe-programa-inedito-para-ensino-medio-no-brasil\\\",\\\"title\\\":\\\"Insper celebra 25 anos de parceria com a University of Chicago e recebe programa inédito para ensino médio no Brasil\\\",\\\"variant\\\":\\\"imagecolor\\\",\\\"buttonText\\\":\\\"Saiba mais\\\",\\\"linkRedirect\\\":\\\"https://www.insper.edu.br/pt/conteudos/acontece-no-insper/insper-celebra-25-anos-de-parceria-com-a-university-of-chicago-e-recebe-programa-inedito-para-ensino-medio-no-brasil\\\"},{\\\"jcr:title\\\":\\\"turquesa / preto / vermelho\\\"},{\\\"themeName\\\":\\\"turquesa / preto / vermelho\\\"},{\\\"richText\\\":\\\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\\",\\\"madeBy\\\":\\\"Por\\\",\\\"tag\\\":\\\"programas:pós-graduação\\\",\\\"buttonUrl\\\":\\\"https://www.insper.edu.br/pt/conteudos/gestao-e-negocios/pos-graduacao-modular-como-funciona-e-quais-sao-as-vantagens-para-jovens-profissionais\\\",\\\"title\\\":\\\"Pós-graduação modular: como funciona e quais são as vantagens para jovens profissionais\\\",\\\"variant\\\":\\\"imagecolor\\\",\\\"buttonText\\\":\\\"Acesse e saiba mais\\\",\\\"linkRedirect\\\":\\\"https://www.insper.edu.br/pt/conteudos/gestao-e-negocios/pos-graduacao-modular-como-funciona-e-quais-sao-as-vantagens-para-jovens-profissionais\\\"},{\\\"jcr:title\\\":\\\"vermelho / amarelo / preto\\\"},{\\\"themeName\\\":\\\"vermelho / amarelo / preto\\\",\\\"backgroundColor\\\":\\\"rgb(229,5,5)\\\"},{\\\"linkIcon1\\\":\\\"icon-insper-return-arrow\\\